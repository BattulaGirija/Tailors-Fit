rules_version = '2';

// Access rules for Tailors Fit. Paste into Firebase console → Firestore Database → Rules → Publish.
//
// - A tailor can read and write only their own profile and customers.
// - Admins (a document admins/{uid}, created by hand in the console) can read every tailor,
//   remove (disable) tailors and edit the shared designs.
// - Nobody can make themselves an admin or re-enable a removed account from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActive(uid) {
      return !get(/databases/$(database)/documents/users/$(uid)).data.get('disabled', false);
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'shop', 'phone', 'email', 'createdAt', 'lastActiveAt', 'patterns', 'customers']);
      allow update: if (isOwner(uid) && isActive(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'shop', 'phone', 'lastActiveAt', 'patterns', 'customers']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']));
      allow delete: if false;

      match /customers/{customerId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) && isActive(uid);
      }
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
